<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxing is off (not App Store distributed): Phase 11's Backup
	     button accepts an arbitrary typed/pasted destination path, which
	     the App Sandbox cannot allow — a sandboxed app can only write to
	     paths the admin picks through an NSOpenPanel, never a typed one. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
